PINK='\033[1;35m'
RESET='\033[0m'

# --- Git Welcome Banner ---
echo -e "${PINK}   _   _      _ _       ${RESET}"
echo -e "${PINK}  | | | | ___| | | ___  ${RESET}"
echo -e "${PINK}  | |_| |/ _ \ | |/ _ \ ${RESET}"
echo -e "${PINK}  |  _  |  __/ | | (_) |${RESET}"
echo -e "${PINK}  |_| |_|\___|_|_|\___/ ${RESET}"
echo -e "${PINK}                        ${RESET}"
echo -e "${PINK}  Git Bash Ready! 🚀${RESET}"
echo -e "${PINK}------------------------${RESET}"
